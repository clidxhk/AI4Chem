{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.04,
      "to": 2.52,
      "sid": 1,
      "location": 2,
      "content": "这两年AI圈的热词层出不穷",
      "music": 0.0
    },
    {
      "from": 2.52,
      "to": 4.32,
      "sid": 2,
      "location": 2,
      "content": "L l m token prompt",
      "music": 0.0
    },
    {
      "from": 4.32,
      "to": 6.44,
      "sid": 3,
      "location": 2,
      "content": "R a g m c p agents skill",
      "music": 0.0
    },
    {
      "from": 6.44,
      "to": 8.16,
      "sid": 4,
      "location": 2,
      "content": "光是念一遍就让人头大",
      "music": 0.0
    },
    {
      "from": 8.16,
      "to": 9.76,
      "sid": 5,
      "location": 2,
      "content": "这些词是怎么出现的",
      "music": 0.0
    },
    {
      "from": 9.76,
      "to": 11.12,
      "sid": 6,
      "location": 2,
      "content": "各自解决什么问题",
      "music": 0.0
    },
    {
      "from": 11.12,
      "to": 12.82,
      "sid": 7,
      "location": 2,
      "content": "今天用一个视频讲明白",
      "music": 0.0
    },
    {
      "from": 12.82,
      "to": 14.84,
      "sid": 8,
      "location": 2,
      "content": "假设你这周末想到杭州玩",
      "music": 0.0
    },
    {
      "from": 14.84,
      "to": 16.12,
      "sid": 9,
      "location": 2,
      "content": "你打开对话窗口",
      "music": 0.0
    },
    {
      "from": 16.12,
      "to": 17.3,
      "sid": 10,
      "location": 2,
      "content": "随口问一句",
      "music": 0.0
    },
    {
      "from": 17.3,
      "to": 18.76,
      "sid": 11,
      "location": 2,
      "content": "他很快给了一段答复",
      "music": 0.0
    },
    {
      "from": 18.76,
      "to": 21.06,
      "sid": 12,
      "location": 2,
      "content": "这背后的核心就是大语言模型",
      "music": 0.0
    },
    {
      "from": 21.06,
      "to": 24.5,
      "sid": 13,
      "location": 2,
      "content": "LLM他将你的话拆解为不是一个字",
      "music": 0.0
    },
    {
      "from": 24.5,
      "to": 26.08,
      "sid": 14,
      "location": 2,
      "content": "也不完全等于一个词",
      "music": 0.0
    },
    {
      "from": 26.08,
      "to": 28.6,
      "sid": 15,
      "location": 2,
      "content": "只是大模型理解文字的最小单元",
      "music": 0.0
    },
    {
      "from": 28.6,
      "to": 31.34,
      "sid": 16,
      "location": 2,
      "content": "每个token对应着一个数字叫token id",
      "music": 0.0
    },
    {
      "from": 31.34,
      "to": 32.64,
      "sid": 17,
      "location": 2,
      "content": "大模型通过计算",
      "music": 0.0
    },
    {
      "from": 32.64,
      "to": 35.32,
      "sid": 18,
      "location": 2,
      "content": "预测出一个token后面最该接哪一个",
      "music": 0.0
    },
    {
      "from": 35.32,
      "to": 36.96,
      "sid": 19,
      "location": 2,
      "content": "从而拼凑出完整回答",
      "music": 0.0
    },
    {
      "from": 36.96,
      "to": 38.04,
      "sid": 20,
      "location": 2,
      "content": "在这个过程中",
      "music": 0.0
    },
    {
      "from": 38.04,
      "to": 40.499,
      "sid": 21,
      "location": 2,
      "content": "你的提问就是prompt提示词",
      "music": 0.0
    },
    {
      "from": 40.499,
      "to": 41.999,
      "sid": 22,
      "location": 2,
      "content": "不过你随口一问",
      "music": 0.0
    },
    {
      "from": 41.999,
      "to": 43.319,
      "sid": 23,
      "location": 2,
      "content": "AI回答很浅显",
      "music": 0.0
    },
    {
      "from": 43.319,
      "to": 44.24,
      "sid": 24,
      "location": 2,
      "content": "换一种问法",
      "music": 0.0
    },
    {
      "from": 44.24,
      "to": 45.18,
      "sid": 25,
      "location": 2,
      "content": "预算2000",
      "music": 0.0
    },
    {
      "from": 45.18,
      "to": 46.72,
      "sid": 26,
      "location": 2,
      "content": "帮我按天规划行程",
      "music": 0.0
    },
    {
      "from": 46.72,
      "to": 48.16,
      "sid": 27,
      "location": 2,
      "content": "回答立刻好用很多",
      "music": 0.0
    },
    {
      "from": 48.16,
      "to": 52.34,
      "sid": 28,
      "location": 2,
      "content": "这套把话说清楚的方法论就叫pro engineering提示词",
      "music": 0.0
    },
    {
      "from": 52.34,
      "to": 54.98,
      "sid": 29,
      "location": 2,
      "content": "工厂规划旅行不可能一句话说完",
      "music": 0.0
    },
    {
      "from": 54.98,
      "to": 57.1,
      "sid": 30,
      "location": 2,
      "content": "以限定预算2000又补充",
      "music": 0.0
    },
    {
      "from": 57.1,
      "to": 58.32,
      "sid": 31,
      "location": 2,
      "content": "不想去网红景点",
      "music": 0.0
    },
    {
      "from": 58.32,
      "to": 60.02,
      "sid": 32,
      "location": 2,
      "content": "AI都能调整推荐方向",
      "music": 0.0
    },
    {
      "from": 60.02,
      "to": 61.2,
      "sid": 33,
      "location": 2,
      "content": "他是怎么记住的",
      "music": 0.0
    },
    {
      "from": 61.2,
      "to": 62.6,
      "sid": 34,
      "location": 2,
      "content": "因为每次发消息时",
      "music": 0.0
    },
    {
      "from": 62.6,
      "to": 65.64,
      "sid": 35,
      "location": 2,
      "content": "系统会把之前的对话一起打包发给大模型",
      "music": 0.0
    },
    {
      "from": 65.64,
      "to": 66.68,
      "sid": 36,
      "location": 2,
      "content": "这就是context",
      "music": 0.0
    },
    {
      "from": 66.68,
      "to": 68.48,
      "sid": 37,
      "location": 2,
      "content": "也就是我们常说的上下文",
      "music": 0.0
    },
    {
      "from": 68.48,
      "to": 71.28,
      "sid": 38,
      "location": 2,
      "content": "但大模型理解上下文的长度是有限的",
      "music": 0.0
    },
    {
      "from": 71.28,
      "to": 72.64,
      "sid": 39,
      "location": 2,
      "content": "随着对话不断积累",
      "music": 0.0
    },
    {
      "from": 72.64,
      "to": 74.36,
      "sid": 40,
      "location": 2,
      "content": "模型会忘记最开始的内容",
      "music": 0.0
    },
    {
      "from": 74.36,
      "to": 75.68,
      "sid": 41,
      "location": 2,
      "content": "一个常见的做法是",
      "music": 0.0
    },
    {
      "from": 75.68,
      "to": 78.38,
      "sid": 42,
      "location": 2,
      "content": "让模型把之前的对话做一次压缩总结",
      "music": 0.0
    },
    {
      "from": 78.38,
      "to": 79.72,
      "sid": 43,
      "location": 2,
      "content": "只保留关键信息",
      "music": 0.0
    },
    {
      "from": 79.72,
      "to": 83.58,
      "sid": 44,
      "location": 2,
      "content": "这个被压缩过的关键信息就是memory模型的记忆",
      "music": 0.0
    },
    {
      "from": 83.58,
      "to": 84.38,
      "sid": 45,
      "location": 2,
      "content": "到这里",
      "music": 0.0
    },
    {
      "from": 84.38,
      "to": 87.72,
      "sid": 46,
      "location": 2,
      "content": "模型已经越来越接近我们想象中智能的样子了",
      "music": 0.0
    },
    {
      "from": 87.72,
      "to": 88.64,
      "sid": 47,
      "location": 2,
      "content": "对话继续",
      "music": 0.0
    },
    {
      "from": 88.64,
      "to": 89.65,
      "sid": 48,
      "location": 2,
      "content": "你接着问",
      "music": 0.0
    },
    {
      "from": 89.65,
      "to": 91.71,
      "sid": 49,
      "location": 2,
      "content": "看看我之前收藏的旅行攻略",
      "music": 0.0
    },
    {
      "from": 91.71,
      "to": 93.14,
      "sid": 50,
      "location": 2,
      "content": "规划行程啊",
      "music": 0.0
    },
    {
      "from": 93.14,
      "to": 94.42,
      "sid": 51,
      "location": 2,
      "content": "哦模型宕机了",
      "music": 0.0
    },
    {
      "from": 94.42,
      "to": 96.36,
      "sid": 52,
      "location": 2,
      "content": "他不知道你收藏的攻略是什么",
      "music": 0.0
    },
    {
      "from": 96.36,
      "to": 99.38,
      "sid": 53,
      "location": 2,
      "content": "这时候就需要RAG检索增强生成",
      "music": 0.0
    },
    {
      "from": 99.38,
      "to": 100.98,
      "sid": 54,
      "location": 2,
      "content": "它能读取你的私有资料",
      "music": 0.0
    },
    {
      "from": 100.98,
      "to": 102.76,
      "sid": 55,
      "location": 2,
      "content": "让回答更加真实可靠",
      "music": 0.0
    },
    {
      "from": 102.76,
      "to": 104.64,
      "sid": 56,
      "location": 2,
      "content": "他先把你的资料切成小片段",
      "music": 0.0
    },
    {
      "from": 104.64,
      "to": 105.4,
      "sid": 57,
      "location": 2,
      "content": "存进知识库",
      "music": 0.0
    },
    {
      "from": 105.4,
      "to": 106.46,
      "sid": 58,
      "location": 2,
      "content": "当你提问时",
      "music": 0.0
    },
    {
      "from": 106.46,
      "to": 108.52,
      "sid": 59,
      "location": 2,
      "content": "系统检索出最相关的片段",
      "music": 0.0
    },
    {
      "from": 108.52,
      "to": 111.42,
      "sid": 60,
      "location": 2,
      "content": "并作为背景资料和你的问题拼接模型",
      "music": 0.0
    },
    {
      "from": 111.42,
      "to": 113.14,
      "sid": 61,
      "location": 2,
      "content": "阅读这段增强后的上下文",
      "music": 0.0
    },
    {
      "from": 113.14,
      "to": 114.58,
      "sid": 62,
      "location": 2,
      "content": "给你生成准确的回复",
      "music": 0.0
    },
    {
      "from": 114.58,
      "to": 117.62,
      "sid": 63,
      "location": 2,
      "content": "我们现在接触到的AI客服AI问答助手",
      "music": 0.0
    },
    {
      "from": 117.62,
      "to": 119.74,
      "sid": 64,
      "location": 2,
      "content": "其实背后都是在用RAG技术",
      "music": 0.0
    },
    {
      "from": 119.74,
      "to": 122.6,
      "sid": 65,
      "location": 2,
      "content": "归根结底它也只是让模型答得更好",
      "music": 0.0
    },
    {
      "from": 122.6,
      "to": 124.36,
      "sid": 66,
      "location": 2,
      "content": "但大模型还不能真正干活",
      "music": 0.0
    },
    {
      "from": 124.36,
      "to": 126.5,
      "sid": 67,
      "location": 2,
      "content": "你说帮我查询一下高铁票",
      "music": 0.0
    },
    {
      "from": 126.5,
      "to": 127.28,
      "sid": 68,
      "location": 2,
      "content": "AI回复",
      "music": 0.0
    },
    {
      "from": 127.28,
      "to": 128.74,
      "sid": 69,
      "location": 2,
      "content": "你可以打开12306",
      "music": 0.0
    },
    {
      "from": 128.74,
      "to": 130.3,
      "sid": 70,
      "location": 2,
      "content": "他只会告诉你怎么做",
      "music": 0.0
    },
    {
      "from": 130.3,
      "to": 132.62,
      "sid": 71,
      "location": 2,
      "content": "但没法真的查询到高铁车次",
      "music": 0.0
    },
    {
      "from": 132.62,
      "to": 134.42,
      "sid": 72,
      "location": 2,
      "content": "荒神calling机智登场了",
      "music": 0.0
    },
    {
      "from": 134.42,
      "to": 137.3,
      "sid": 73,
      "location": 2,
      "content": "它让大模型具备能够接入外部工具的能力",
      "music": 0.0
    },
    {
      "from": 137.3,
      "to": 138.64,
      "sid": 74,
      "location": 2,
      "content": "整个机制是这样的",
      "music": 0.0
    },
    {
      "from": 138.64,
      "to": 141.62,
      "sid": 75,
      "location": 2,
      "content": "程序先告诉模型有什么第三方工具可以用",
      "music": 0.0
    },
    {
      "from": 141.62,
      "to": 143.14,
      "sid": 76,
      "location": 2,
      "content": "再把你的对话发过去",
      "music": 0.0
    },
    {
      "from": 143.14,
      "to": 145.54,
      "sid": 77,
      "location": 2,
      "content": "当模型判断需要调用工具时",
      "music": 0.0
    },
    {
      "from": 145.54,
      "to": 147.58,
      "sid": 78,
      "location": 2,
      "content": "需要输出一段结构化的函数",
      "music": 0.0
    },
    {
      "from": 147.58,
      "to": 150.61,
      "sid": 79,
      "location": 2,
      "content": "调用指令程序拿到指令去查询车次",
      "music": 0.0
    },
    {
      "from": 150.61,
      "to": 152.51,
      "sid": 80,
      "location": 2,
      "content": "再把结果返还给模型",
      "music": 0.0
    },
    {
      "from": 152.51,
      "to": 156.22,
      "sid": 81,
      "location": 2,
      "content": "这时候模型就可以回复符合行程规划的车票有",
      "music": 0.0
    },
    {
      "from": 156.22,
      "to": 157.72,
      "sid": 82,
      "location": 2,
      "content": "但这里有个工程问题",
      "music": 0.0
    },
    {
      "from": 157.72,
      "to": 159.22,
      "sid": 83,
      "location": 2,
      "content": "每接入一个新工具",
      "music": 0.0
    },
    {
      "from": 159.22,
      "to": 161.06,
      "sid": 84,
      "location": 2,
      "content": "就需要单独写适配代码",
      "music": 0.0
    },
    {
      "from": 161.06,
      "to": 163.8,
      "sid": 85,
      "location": 2,
      "content": "不同应用之间这些工作完全无法复用",
      "music": 0.0
    },
    {
      "from": 163.8,
      "to": 165.34,
      "sid": 86,
      "location": 2,
      "content": "于是有了MCP",
      "music": 0.0
    },
    {
      "from": 165.34,
      "to": 168.56,
      "sid": 87,
      "location": 2,
      "content": "它让所有第三方工具的接口统一了AI程序",
      "music": 0.0
    },
    {
      "from": 168.56,
      "to": 170.9,
      "sid": 88,
      "location": 2,
      "content": "只需要对接MCP这一个协议",
      "music": 0.0
    },
    {
      "from": 170.9,
      "to": 173.62,
      "sid": 89,
      "location": 2,
      "content": "就能调用所有使用同一接口的工具",
      "music": 0.0
    },
    {
      "from": 173.62,
      "to": 176.58,
      "sid": 90,
      "location": 2,
      "content": "很多人会把function calling和MCP混淆",
      "music": 0.0
    },
    {
      "from": 176.58,
      "to": 178.1,
      "sid": 91,
      "location": 2,
      "content": "觉得不是同一个东西吗",
      "music": 0.0
    },
    {
      "from": 178.1,
      "to": 179.3,
      "sid": 92,
      "location": 2,
      "content": "其实差别可大了",
      "music": 0.0
    },
    {
      "from": 179.3,
      "to": 182.98,
      "sid": 93,
      "location": 2,
      "content": "FUNGUARLING是让模型按照约定格式输出调用指令",
      "music": 0.0
    },
    {
      "from": 182.98,
      "to": 186.7,
      "sid": 94,
      "location": 2,
      "content": "而MCP是让所有工具都遵循同一种格式",
      "music": 0.0
    },
    {
      "from": 186.7,
      "to": 187.84,
      "sid": 95,
      "location": 2,
      "content": "被模型接入",
      "music": 0.0
    },
    {
      "from": 187.84,
      "to": 189.6,
      "sid": 96,
      "location": 2,
      "content": "AI能接入不同工具了",
      "music": 0.0
    },
    {
      "from": 189.6,
      "to": 190.28,
      "sid": 97,
      "location": 2,
      "content": "很不错",
      "music": 0.0
    },
    {
      "from": 190.28,
      "to": 192.04,
      "sid": 98,
      "location": 2,
      "content": "但你还得一步步指挥他",
      "music": 0.0
    },
    {
      "from": 192.04,
      "to": 193.48,
      "sid": 99,
      "location": 2,
      "content": "能不能你就说一句",
      "music": 0.0
    },
    {
      "from": 193.48,
      "to": 195.32,
      "sid": 100,
      "location": 2,
      "content": "帮我把杭州旅行安排好",
      "music": 0.0
    },
    {
      "from": 195.32,
      "to": 197.06,
      "sid": 101,
      "location": 2,
      "content": "剩下全交给他可以",
      "music": 0.0
    },
    {
      "from": 197.06,
      "to": 198.0,
      "sid": 102,
      "location": 2,
      "content": "这就是agent",
      "music": 0.0
    },
    {
      "from": 198.0,
      "to": 201.24,
      "sid": 103,
      "location": 2,
      "content": "一个agent接到目标后会自己思考该怎么做",
      "music": 0.0
    },
    {
      "from": 201.24,
      "to": 203.12,
      "sid": 104,
      "location": 2,
      "content": "整个过程他自己规划步骤",
      "music": 0.0
    },
    {
      "from": 203.12,
      "to": 204.48,
      "sid": 105,
      "location": 2,
      "content": "自己调用外部工具",
      "music": 0.0
    },
    {
      "from": 204.48,
      "to": 206.34,
      "sid": 106,
      "location": 2,
      "content": "自己记录每一步的结果",
      "music": 0.0
    },
    {
      "from": 206.34,
      "to": 206.82,
      "sid": 107,
      "location": 2,
      "content": "诶",
      "music": 0.0
    },
    {
      "from": 206.82,
      "to": 209.16,
      "sid": 108,
      "location": 2,
      "content": "这不都是我们刚刚讲过的能力吗",
      "music": 0.0
    },
    {
      "from": 209.16,
      "to": 212.159,
      "sid": 109,
      "location": 2,
      "content": "对agent就是在大模型的基础上",
